# Safe local defaults: SQLite + demo headers + mock/sandbox providers.
RIFFLOOM_DEPLOYMENT_PROFILE=local
RIFFLOOM_DATABASE_URL=sqlite:///../data/riffloom.db
RIFFLOOM_DATABASE_SCHEMA_MODE=create_all
RIFFLOOM_CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
RIFFLOOM_AUTH_MODE=demo_headers
RIFFLOOM_DEMO_USER=user_demo
RIFFLOOM_DEMO_WORKSPACE=ws_demo
RIFFLOOM_ASSET_STORAGE_DIR=../uploads

RIFFLOOM_COLLECTION_PROVIDER=sandbox-v1
RIFFLOOM_MODEL_PROVIDER=mock-v1
RIFFLOOM_COVER_PROVIDER=mock-cover-v1
RIFFLOOM_ASR_PROVIDER=disabled
RIFFLOOM_FEISHU_PROVIDER=sandbox-feishu-v1
RIFFLOOM_FEISHU_REAL_WRITES_ENABLED=false

# Optional integrations. Keep blank until you deliberately enable a provider.
TIKHUB_API_KEY=
DEEPSEEK_API_KEY=
ARK_API_KEY=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
RIFFLOOM_FEISHU_OAUTH_REDIRECT_URI=http://localhost:3100/api/riffloom/integrations/feishu/oauth/callback

RIFFLOOM_API_DOCS_ENABLED=true
RIFFLOOM_LOG_LEVEL=INFO
RIFFLOOM_LOG_FORMAT=json
